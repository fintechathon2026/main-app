# Copy to .env.local and fill in. Never commit real values.
# Reference: docs/architecture.md §19.2

# Database (Supabase)
DATABASE_URL=                 # pooled, transaction mode, request paths
DATABASE_URL_DIRECT=          # direct/session, migrations and checkpointer setup()
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LLM
ANTHROPIC_API_KEY=
REINS_PLANNER_MODEL=claude-sonnet-5-5
REINS_READER_MODEL=claude-haiku-5-5
REINS_EXPLAINER_MODEL=claude-haiku-5-5
REINS_MODELS=recorded         # live | recorded | recording

# Mock bank, cron, tracing
MOCKBANK_API_KEY=
CRON_SECRET=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# Eval only; refused when NODE_ENV=production
REINS_EVAL_DISABLE_GATE=
APPROVAL_TTL_MINUTES=15

# Chain (Base Sepolia)
CHAIN_ID=84532
BASE_SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL_FALLBACK=
ESCROW_ADDRESS=
TOKEN_ADDRESS=
ORACLE_ADDRESS=
AGENT_ADDRESS=
REINS_ESCROW=chain            # chain | mock

# Chain keys: read only in src/server/adapters/settlement/chain/**
RELAYER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=

# Simulator keys: read only in src/sim/**
MERCHANT_SIM_PRIVATE_KEY=
ORACLE_PRIVATE_KEY=
SIM_API_KEY=

# Demo environment only
TOKEN_MINTER_PRIVATE_KEY=
