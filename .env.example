# Copy to .env.local and fill in. Never commit real values.
# Reference: docs/architecture.md §19.2

# Database (Supabase)
DATABASE_URL=                 # pooled, transaction mode, request paths
DATABASE_URL_DIRECT=          # direct/session, migrations and checkpointer setup()
DATABASE_URL_POOLER=          # test only: Supabase transaction-mode pooler URL for reins_server (tests/foundations/pooler.test.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LLM
ANTHROPIC_API_KEY=
REINS_PLANNER_MODEL=claude-sonnet-5-5
REINS_READER_MODEL=claude-haiku-5-5
REINS_EXPLAINER_MODEL=claude-haiku-5-5
REINS_MODELS=recorded         # live | recorded | recording
REINS_RECORDING_SCENARIO=demo_lin

# Mock bank, cron, tracing
MOCKBANK_API_KEY=
MOCKBANK_URL=http://localhost:3000/mockbank
MOCKBANK_DATABASE_URL=        # reins_mockbank role; mock bank routes only
MOCKBANK_ENABLE_TEST_ROUTES=  # 1 to enable /mockbank/test/* (never in production)
CRON_SECRET=                  # at least 16 characters
REINS_CRON_USER_IDS=          # comma-separated user ids for cron/detect until R3 adds a definer function
REINS_RISK_USER_IDS=          # comma-separated user ids for cron/risk until R3 adds a definer function
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# Local and demo
REINS_DEMO_AUTH=              # 1 accepts the x-demo-user header (never in production)
REINS_FIXTURES=               # 1 serves fixtures/api/*.json from R1 routes, no DB needed
REINS_DOCUMENTS_BUCKET=       # Supabase Storage bucket for bill PDFs; unset = local .data/documents
REINS_STORAGE_READ_TOKEN=     # JWT for a read-only storage role; server-side Reader jobs read supabase: refs with it (never service_role)

# Eval only; refused when NODE_ENV=production
REINS_EVAL_DISABLE_GATE=
APPROVAL_TTL_MINUTES=15

# Chain (Base Sepolia)
CHAIN_ID=84532
BASE_SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL_FALLBACK=
ESCROW_ADDRESS=
TOKEN_ADDRESS=
ORACLE_ADDRESS=
AGENT_ADDRESS=
REINS_ESCROW=chain            # chain | mock

# Chain keys: read only in src/server/adapters/settlement/chain/**
RELAYER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=

# Simulators (registry, merchant)
SIM_BASE_URL=http://localhost:3000

# Simulator keys: read only in src/sim/** (SIM_API_KEY is also used by the risk job as a client)
MERCHANT_SIM_PRIVATE_KEY=
ORACLE_PRIVATE_KEY=
SIM_API_KEY=

# Demo environment only
TOKEN_MINTER_PRIVATE_KEY=
